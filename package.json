{
  "name": "mern",
  "version": "1.0.0",
  "description": "Mern Demo",
  "main": "server.js",
  "scripts": {
    "start": "if-env NODE_ENV=production && npm run start:prod || npm run start:dev",
    "start:prod": "node server.js",
    "start:dev": "concurrently \"nodemon --ignore 'client/*'\" \"npm run client\"",
    "client": "cd client && npm run start",
    "client:install": "cd client && npm install",
    "build": "cd client && npm run build",
    "postinstall": "cd client && npm install && npm run build",
    "test:e2e": "npx playwright test",
    "test:api": "NODE_ENV=test npx jest --config tests/api/jest.config.js --forceExit --detectOpenHandles"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "if-env": "^1.0.4",
    "morgan": "^1.10.1",
    "mysql": "^2.18.1",
    "mysql2": "^3.17.2",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "passport-local": "^1.0.0",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cravings-app/cravings.git"
  },
  "bugs": {
    "url": "https://github.com/cravings-app/cravings/issues"
  },
  "homepage": "https://github.com/cravings-app/cravings#readme"
}
